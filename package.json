{
  "name": "scm-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc -b && vp build",
    "lint": "vp lint",
    "test": "vp test run",
    "test:watch": "vp test",
    "preview": "vp preview",
    "api:export": "mvn -q -f ../../workspace/scm-temporal/pom.xml test -Dtest=OpenApiExportTest -Dopenapi.export=%CD%/openapi/api.json",
    "api:types": "pnpm dlx --package typescript@5.9.3 --package openapi-typescript@7.13.0 openapi-typescript openapi/api.json -o src/shared/api/schema.d.ts",
    "api:check": "pnpm api:types && git diff --exit-code -- src/shared/api/schema.d.ts",
    "prepare": "vp config"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "bootstrap": "^5.3.8",
    "mermaid": "^12.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-idle-timer": "5.7.3",
    "react-x-mermaid": "^1.0.1"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@rolldown/plugin-babel": "^0.3.1",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "typescript": "~7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
